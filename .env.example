# Bu faylni ".env" nomi bilan nusxalang va o'z qiymatlaringizni kiriting.
# ".env" fayli .gitignore'da bo'lgani uchun GitHub'ga tushmaydi.

# Backend qaysi portda ishga tushishi
PORT=3001

# /admin sahifasiga kirish uchun maxsus kod
ADMIN_CODE=CHANGE_ME_TO_YOUR_OWN_CODE

# Bitta faylning maksimal hajmi (MB). Uzun videolar uchun oshirishingiz mumkin.
MAX_UPLOAD_MB=300
